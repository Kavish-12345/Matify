# Copy this file to ".env" (same folder) and put your real key in it.
# .env is in .gitignore, so the key is never pushed to GitHub.

GROQ_API_KEY=gsk_your_key_here

# Optional: change model or switch to Ollama (offline backup)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# For Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   LLM_API_KEY=ollama
